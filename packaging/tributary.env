# Tributary environment — read by systemd as an EnvironmentFile.
#
# Your edits survive an upgrade. This file may hold a SECRET (the data-plane
# token), so it is 0640 root:tributary. Do not put the token in config.toml.

# -- Data-plane token (SEC-4) -----------------------------------------------
# If the TimeLakeDB server runs TIMELAKE_DATA_AUTH=optional or required, the
# agent must present a write-scoped token. Set it here (the 12-factor path),
# or instead point output.token_file in config.toml at a file. If both are
# set, this wins. Leave it unset when the server's data plane is open.
#TRIBUTARY_TOKEN=tldb_...

# -- Logging ----------------------------------------------------------------
# Tributary logs to stdout, which systemd captures into the journal and
# rotates for you. Raise it for an incident: RUST_LOG=debug.
RUST_LOG=info
